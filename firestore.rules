rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Rol del usuario autenticado. DENIEGA POR DEFECTO: si el documento de
    // usuario no existe o no tiene rol, devuelve '' (sin permisos elevados).
    // (Corrige el hallazgo C2: antes devolvía 'Ganadero' por defecto.)
    function userRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path)
        ? get(path).data.rol
        : '';
    }

    function isVetOrAdmin() {
      return userRole() == 'Veterinario' || userRole() == 'Administrador';
    }

    // Documento de membresía determinista entre un hato (ownerId) y el usuario.
    function membershipPath(ownerId) {
      return /databases/$(database)/documents/memberships/$(ownerId + '_' + request.auth.uid);
    }

    // ¿El usuario actual puede acceder a los datos del hato `ownerId`?
    //  - Es su propio hato, o
    //  - tiene una membresía ACEPTADA en ese hato.
    // (ownerId == '' = dato heredado sin asignar; se permite de forma
    //  transitoria para no romper datos antiguos hasta su backfill.)
    function hasFarmAccess(ownerId) {
      return isSignedIn() && (
        ownerId == '' ||
        ownerId == request.auth.uid ||
        (exists(membershipPath(ownerId)) &&
         get(membershipPath(ownerId)).data.estado == 'aceptada')
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Usuarios: cada quien su documento; admin/ganadero pueden listar.
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isSignedIn() &&
        (request.auth.uid == userId ||
         userRole() == 'Administrador' || userRole() == 'Ganadero');
      allow list: if isSignedIn() &&
        (userRole() == 'Administrador' || userRole() == 'Ganadero' || userRole() == 'Empleado');

      // Creación: solo el propio documento y con un rol permitido.
      // NUNCA 'Administrador' por registro (anti auto-promoción / escalada).
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.rol in ['Ganadero', 'Veterinario', 'Empleado'];

      // Actualización: el usuario edita su perfil pero NO puede cambiar su rol;
      // el cambio de rol queda reservado a un Administrador.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.rol == resource.data.rol) ||
        userRole() == 'Administrador'
      );

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────
    // Bovinos: lectura acotada al propietario (o vet/admin con acceso amplio).
    // (Corrige el hallazgo C1/C3: antes cualquier autenticado leía todo.)
    // La app consulta `where propietarioId == uid`, por lo que el listado
    // acotado por dueño es satisfacible para Ganadero/Empleado.
    // ─────────────────────────────────────────────────────────────
    // Acceso por HATO mediante membresías. `read` cubre get y list: la app
    // consulta `where propietarioId in [hatos accesibles]`, por lo que cada
    // documento devuelto satisface hasFarmAccess; una consulta a hatos no
    // autorizados se rechaza automáticamente.
    match /bovines/{bovineId} {
      allow read: if hasFarmAccess(resource.data.propietarioId);
      allow create: if isSignedIn() &&
        (userRole() == 'Ganadero' || userRole() == 'Empleado' || userRole() == 'Veterinario') &&
        hasFarmAccess(request.resource.data.propietarioId);
      allow update: if isSignedIn() &&
        hasFarmAccess(resource.data.propietarioId);
      allow delete: if isSignedIn() && userRole() == 'Ganadero' &&
        resource.data.propietarioId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // Tratamientos / Vacunas — acotados al hato (heredan propietarioId del bovino)
    // ─────────────────────────────────────────────────────────────
    match /treatments/{treatmentId} {
      allow read: if hasFarmAccess(resource.data.propietarioId);
      allow create: if isSignedIn() &&
        (userRole() == 'Veterinario' || userRole() == 'Ganadero' || userRole() == 'Empleado') &&
        hasFarmAccess(request.resource.data.propietarioId);
      allow update: if isSignedIn() &&
        (userRole() == 'Veterinario' || userRole() == 'Ganadero' || userRole() == 'Empleado') &&
        hasFarmAccess(resource.data.propietarioId);
      allow delete: if isSignedIn() && userRole() == 'Ganadero' &&
        hasFarmAccess(resource.data.propietarioId);
    }

    // ─────────────────────────────────────────────────────────────
    // Inventario — acotado al hato del ganadero
    // ─────────────────────────────────────────────────────────────
    match /inventory/{itemId} {
      allow read: if hasFarmAccess(resource.data.propietarioId);
      allow create: if isSignedIn() &&
        (userRole() == 'Ganadero' || userRole() == 'Empleado' || userRole() == 'Veterinario') &&
        hasFarmAccess(request.resource.data.propietarioId);
      allow update: if isSignedIn() &&
        (userRole() == 'Ganadero' || userRole() == 'Empleado' || userRole() == 'Veterinario') &&
        hasFarmAccess(resource.data.propietarioId);
      allow delete: if isSignedIn() &&
        (userRole() == 'Ganadero' || userRole() == 'Empleado') &&
        hasFarmAccess(resource.data.propietarioId);
    }

    // ─────────────────────────────────────────────────────────────
    // Membresías de hato (invitaciones ganadero → veterinario/empleado)
    // ─────────────────────────────────────────────────────────────
    match /memberships/{membershipId} {
      allow read: if isSignedIn() &&
        (resource.data.ganaderoId == request.auth.uid ||
         resource.data.memberId == request.auth.uid);
      // Solo un ganadero crea invitaciones para su propio hato.
      allow create: if isSignedIn() &&
        userRole() == 'Ganadero' &&
        request.resource.data.ganaderoId == request.auth.uid;
      // El ganadero (revocar) o el miembro (aceptar/rechazar) actualizan.
      allow update: if isSignedIn() &&
        (resource.data.ganaderoId == request.auth.uid ||
         resource.data.memberId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.ganaderoId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // Reportes
    // ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && userRole() == 'Ganadero';
    }

    // ─────────────────────────────────────────────────────────────
    // Notificaciones: solo el destinatario las lee/gestiona, y solo se
    // pueden CREAR a nombre propio (o por vet/admin). (Corrige C5.)
    // ─────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() &&
        resource.data.usuarioId == request.auth.uid;
      allow create: if isSignedIn() &&
        (request.resource.data.usuarioId == request.auth.uid || isVetOrAdmin());
      allow update, delete: if isSignedIn() &&
        resource.data.usuarioId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // Incidentes / Mortalidad
    // ─────────────────────────────────────────────────────────────
    match /incidents/{incidentId} {
      allow read: if hasFarmAccess(resource.data.propietarioId);
      allow create: if isSignedIn() &&
        (userRole() == 'Veterinario' || userRole() == 'Ganadero' || userRole() == 'Empleado') &&
        hasFarmAccess(request.resource.data.propietarioId);
      allow update: if isSignedIn() &&
        (userRole() == 'Veterinario' || userRole() == 'Ganadero' || userRole() == 'Empleado') &&
        hasFarmAccess(resource.data.propietarioId);
      allow delete: if isSignedIn() && userRole() == 'Ganadero' &&
        hasFarmAccess(resource.data.propietarioId);
    }

    // ─────────────────────────────────────────────────────────────
    // Actividades (auditoría): cada quien crea las suyas.
    // ─────────────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.usuarioId == request.auth.uid;
    }
  }
}
